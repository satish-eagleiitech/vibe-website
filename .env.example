# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=Hyderabad

# TMDB v3 — server only. Do not use NEXT_PUBLIC_ for this key.
# Expo-style name is supported so the same value can be pasted.
EXPO_PUBLIC_TMDB_API_KEY=
MOVIES_API_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Google Maps
# Vite-style name is supported. Next.js also needs NEXT_PUBLIC_ for client maps.
VITE_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional later APIs (events, activities, experiences)
NEXT_PUBLIC_API_BASE_URL=
